**/bin/
**/obj/
**/node_modules/
**/.angular/
.env

# The Angular production build is written straight into the API project's wwwroot by
# angular.json's outputPath. It is a build artifact and is never committed.
src/api/Fireworks.Api/wwwroot/

# OS and local tooling noise. Team config in .claude/agents/ and .squad/ IS committed;
# only per-machine Claude Code settings are ignored.
.DS_Store
.claude/settings.local.json

# Test-tier output (tools/test/run.mjs): per-step logs, summary.json, the daily results that
# daily-status.mjs reads for the 24-hour gate rule, browser-gate JSON and mutant rigs. Local only.
test-results/
