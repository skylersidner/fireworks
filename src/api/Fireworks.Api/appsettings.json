{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF logs every command's SQL at Information; parameter values stay redacted unless
      // EnableSensitiveDataLogging is on, but the volume is noise in production (Boo F4).
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // Identity (plan §3.4). Startup fails fast if DefaultUserId is missing, blank, not a GUID, or
  // the empty GUID. The id is not a secret: it only names the row that owns saved data until the
  // Phase 8 auth pass.
  //
  // AllowAnonymousWrites is false here, so production writes are OFF (decided, plan §5 OQ20). Turn
  // them on in Railway only while testing, with Identity__AllowAnonymousWrites=true, then remove it.
  "Identity": {
    "DefaultUserId": "6933f933-a9e9-443b-b7c7-6e3e01901a34",
    "AllowAnonymousWrites": false
  },

  // Show Builder playback tuning, served to the SPA by GET api/client-config and read once at page
  // load. Override on Railway with ClientPlayback__SeekBudgetMs=40 and so on. The API refuses to
  // start on an out-of-range value. What each one does: README, "Playback tuning (ClientPlayback)".
  //   SeekBudgetMs               4..100   ms of seek/catch-up simulation per animation frame
  //   CatchingUpDelayMs          0..5000  ms a seek runs before "Catching up…" shows
  //   CheckpointIntervalSeconds  1..60    show seconds between seek snapshots
  //   CheckpointMemoryMiB        8..512   memory cap for seek snapshots
  "ClientPlayback": {
    "SeekBudgetMs": 25,
    "CatchingUpDelayMs": 300,
    "CheckpointIntervalSeconds": 10,
    "CheckpointMemoryMiB": 64
  },

  // Deployment configuration comes from environment variables, using the "__" separator.
  // Nothing below is committed; these are the variables the deployment must supply.
  //
  //   ConnectionStrings__Postgres   Npgsql key=value string, NOT a postgresql:// URI —
  //                                 Npgsql cannot parse the URI form. On Railway, compose it
  //                                 from the addon's parts in the variable editor:
  //                                 Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};
  //                                 Database=${{Postgres.PGDATABASE}};
  //                                 Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}}
  //   ASPNETCORE_ENVIRONMENT        Production
  //
  // ConnectionStrings and Cors deliberately live in appsettings.Development.json only, so the
  // "?? throw" guards in Program.cs actually fire on a misconfigured production deploy instead of
  // silently resolving a committed local placeholder.
  //
  // AllowedHosts must keep "healthcheck.railway.app" in the list if it is ever tightened from "*"
  // — Railway's deploy probe sends that Host header, and a 400 means the deploy never goes live.
  "AllowedHosts": "*"
}
