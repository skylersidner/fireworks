{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=fireworks;Username=fireworks_app;Password=fireworks_dev_password"
  },
  // Local sign-in goes to the stub OAuth server (tools/fake-oauth/server.mjs, 127.0.0.1:5190) by
  // default; the pair below is a placeholder, not a credential. To use your own Google dev client,
  // set ClientId and ClientSecret with dotnet user-secrets AND blank the three endpoints there
  // (an empty value means Google's default). README, "Sign-in".
  "Auth": {
    "Providers": {
      "Google": {
        "ClientId": "fireworks-stub-client",
        "ClientSecret": "stub-secret-not-a-credential",
        "AuthorizationEndpoint": "http://127.0.0.1:5190/authorize",
        "TokenEndpoint": "http://127.0.0.1:5190/token",
        "UserInformationEndpoint": "http://127.0.0.1:5190/userinfo"
      }
    }
  }
}
